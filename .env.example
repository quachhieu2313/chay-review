# Copy file này thành .env và điền giá trị thật. Không commit file .env lên git.

# Bắt buộc khi deploy production (DEBUG=False)
SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai-va-bi-mat
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Khi deploy free lên Render/Railway... thêm domain vào đây, cách nhau bằng dấu phẩy
# ALLOWED_HOSTS=ten-app-cua-ban.onrender.com
# CSRF_TRUSTED_ORIGINS=https://ten-app-cua-ban.onrender.com

# Database - để trống thì dùng SQLite local. Khi deploy free, lấy connection string
# Postgres miễn phí từ Neon.tech hoặc Supabase rồi dán vào đây.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Lưu ảnh upload lên Cloudinary (free tier) thay vì ổ đĩa local, vì hosting free
# (Render...) sẽ mất hết file mỗi lần redeploy.
# USE_CLOUDINARY=True
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Google Analytics (free) - lấy Measurement ID dạng G-XXXXXXX tại analytics.google.com
# GA_MEASUREMENT_ID=G-XXXXXXX
